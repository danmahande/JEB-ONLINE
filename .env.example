# ---------------------------------------------------------------------------
# Meridian Supply Co. / JEB-ONLINE — environment reference
#
# Copy to `.env` (local) or set in the Vercel project (production).
# `.env` is gitignored; never commit real values.
# ---------------------------------------------------------------------------

# --- required -----------------------------------------------------------------

# PostgreSQL connection string. The schema provider is `postgresql`
# (prisma/schema.prisma), so this must start with postgresql:// or postgres://
# A `file:` (SQLite) URL will fail at runtime — the storefront feed returns 500
# and the seed cannot run.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Unpooled/direct connection, used by Prisma for migrations (directUrl in the
# schema). On Neon this is the non-`-pooler` host. Required in production.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Signs customer sessions and the retry identifiers used by the rate limiters.
# Must be at least 32 characters; customer auth refuses to run below that.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=""

# --- canonical origin ---------------------------------------------------------

# Absolute origin of the deployment. Used for metadataBase, canonical links,
# product og:image URLs, sitemap.xml and the Sitemap line in robots.txt.
# WITHOUT IT THESE SILENTLY POINT AT http://localhost:3000 — the sitemap
# advertises localhost URLs and social previews break.
# e.g. https://jeb-online.vercel.app  (no trailing slash)
NEXT_PUBLIC_SITE_URL=""

# --- optional -----------------------------------------------------------------

# Order/notification email via Resend. With either value unset, mail.ts runs in
# LOG-ONLY mode: sends are written to the server log and return {sent:false}.
RESEND_API_KEY=""
# Verified sender, e.g. "Meridian Supply <orders@meridiansupply.co>"
MAIL_FROM=""
# Where new-order alerts go. Defaults to MAIL_FROM.
OWNER_ALERT_EMAIL=""

# Digits only, international format, no "+". The contact page renders a WhatsApp
# button ONLY when this is set; otherwise it states plainly that it is not online.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Admin bootstrap — only needed by scripts/hash-admin-password.ts.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- test suite (scripts/verify-round7-fix.js) --------------------------------

# Base URL the suite drives. Defaults to http://localhost:3000.
BASE_URL=""
# Credentials the suite uses to sign into /admin.
SUITE_ADMIN_EMAIL=""
SUITE_ADMIN_PASSWORD=""
