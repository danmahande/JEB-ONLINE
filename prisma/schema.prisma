// ============================================================
// MERIDIAN SUPPLY — Storefront data layer
// Model + field names intentionally mirror an upstream ERP's
// schema so payloads can be synced to a real ERP instance
// with minimal glue.
// Storefront extensions are marked with "— storefront extension".
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// Upstream ERP Product model (subset) + storefront extensions
model Product {
  id                String   @id @default(cuid())
  productId         String   @unique // e.g. "GRN-MAIZE-25"
  productLabel      String
  /// Editable product description for catalogs and invoices
  description       String?  @default("")
  /// Brand name (e.g. "MERIDIAN MILLS")
  brand             String?
  /// Default variant descriptor (e.g. "25KG BAG")
  variant           String?
  /// Category: GRAINS | HARDWARE
  category          String
  merchantId        String   @default("MCH-MRD-001")
  merchantName      String   @default("Meridian Supply Co.")
  /// Selling unit: BAG | PIECE | CARTON | SHEET
  unit              String
  /// Product weight (e.g. "25KG")
  weight            String?
  minStock          Int      @default(10)
  /// Base cost in USD
  unitCost          Float
  /// Base selling price in USD
  unitSellingPrice  Float
  commissionPercent Float    @default(0)
  currentStock      Int      @default(0)
  /// IAS 2 costing method: fifo | avco | standard | specific_id
  costingMethod     String   @default("fifo")
  isActive          Boolean  @default(true)
  // ---- storefront extensions ----
  slug              String   @unique
  image             String?
  /// Harmonized System code for customs declarations
  hsCode            String?
  /// ISO country of origin (drives EAC preferential duty)
  originCountry     String   @default("UG")
  /// JSON array of sellable variants: [{ "label": "25KG BAG", "priceDelta": 0, "weightKg": 25 }]
  variants          String   @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

/// Upstream ERP Customer model + country extension
model Customer {
  id              String   @id @default(cuid())
  customerId      String   @unique
  name            String
  contact         String   @unique // phone
  email           String?
  address         String?
  // ---- storefront extension ----
  country         String   @default("UG")
  createdBy       String?
  totalOrders     Int      @default(0)
  totalOrderValue Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Upstream ERP OrderProcessing model + cross-border extensions
model OrderProcessing {
  id               String    @id @default(cuid())
  orderId          String    @unique
  orderNumber      String    @unique // DS100001-style, matches ERP convention
  orderDate        DateTime  @default(now())
  customerId       String
  customerName     String
  /// Full customer contact details
  customerInfo     String
  /// Order total in USD (base currency)
  totalAmount      Float
  /// Cash, MTN MoMo, M-Pesa, Airtel Money, Bank Transfer
  paymentMethod    String
  /// new_order | processing | shipped | delivered | returned | cancelled
  status           String    @default("new_order")
  trackingNumber   String?
  /// True while trackingNumber is the placeholder generated at checkout
  /// (TRK-<order>-<region>). Flipped false when the owner enters the real
  /// waybill at dispatch, so "the customer is looking at a fake number" is
  /// detectable rather than a matter of memory.
  trackingIsPlaceholder Boolean @default(true)
  /// Set when the order is marked shipped — the real dispatch time, distinct
  /// from updatedAt (which moves on every edit).
  dispatchedAt     DateTime?
  invoiceGenerated Boolean   @default(false)
  invoiceNumber    String?
  invoiceDate      DateTime?
  createdBy        String    @default("STOREFRONT")
  // ---- storefront extensions (cross-border) ----
  currency         String    @default("USD")
  fxRate           Float     @default(1)
  region           String    @default("INTL")
  destination      String?
  dutyAmount       Float     @default(0)
  vatAmount        Float     @default(0)
  shippingAmount   Float     @default(0)
  totalWeightKg    Float     @default(0)
  /// Person collecting the consignment at the destination bus terminal
  /// (Round 27 — required at checkout whenever the region is served by a
  /// bus cargo operator). Null on legacy rows and standard-freight orders.
  receiverName     String?
  receiverPhone    String?
  /// Freight snapshot — bus cargo operator chosen at checkout. The order
  /// stores the operator's name + tariff AT ORDER TIME so later rate
  /// edits in /admin/operators never rewrite historical orders.
  operatorName      String?
  operatorRatePerKg Float?
  operatorMinCharge Float?
  /// bus_operator | standard
  freightSource    String    @default("standard")
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // ---- payment (round 31) ----
  // This store takes no money on the site; payment is arranged by hand. These
  // fields are the owner's record of what actually arrived, so "who has paid"
  // is answerable from the dashboard instead of from memory.
  // Derived from PaymentRecord rows inside a transaction — never edited alone.
  /// unpaid | partial | paid
  paymentStatus    String    @default("unpaid")
  paidAt           DateTime?
  /// USD received so far (sum of PaymentRecord.amountUsd)
  paidAmountUsd    Float     @default(0)

  payments PaymentRecord[]

  lineItems OrderLineItem[]
  events    OrderEvent[]
  customerAccountId String?
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([customerAccountId, createdAt])
  @@index([status])
  @@index([orderDate])
  @@index([paymentStatus])
}

model CustomerAccount {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders OrderProcessing[]
}

/// Upstream ERP OrderLineItem model
model OrderLineItem {
  id               String   @id @default(cuid())
  orderId          String
  orderNumber      String
  productId        String
  productName      String
  brand            String?
  variant          String?
  qty              Int
  unitSellingPrice Float
  lineTotal        Float
  createdAt        DateTime @default(now())

  order OrderProcessing @relation(fields: [orderId], references: [orderId])

  @@index([orderId])
  @@index([orderNumber])
  @@index([productId])
}

/// Cross-border trade config (storefront extension)
model RegionConfig {
  id            String @id @default(cuid())
  /// Region code: UG | KE | TZ | RW | CD | INTL
  region        String @unique
  countryName   String
  currency      String
  symbol        String
  rateToUsd     Float
  /// Last time a live FX API refreshed this rate (null = still the seeded default)
  fxUpdatedAt   DateTime?
  /// Import duty rate for EAC-origin goods (0 within EAC per CET preference)
  dutyRate      Float
  vatRate       Float
  shippingBase  Float
  shippingPerKg Float
  etaDays       String
  /// Structured transit window in days (Round 27). Null = fall back to the
  /// etaDays string above. Bus-operator regions inherit the operator's
  /// transit window at checkout; these fields cover the standard/forwarder path.
  etaDaysMin    Int?
  etaDaysMax    Int?
  isEac         Boolean @default(true)

  operators BusOperator[]
}

/// Bus cargo operators (storefront extension, Round 27).
/// Freight on EAC corridors is quoted from REAL operator cargo tariffs —
/// per-kg rate with a minimum charge — instead of flat per-region math.
/// Rates are USD (the store's base currency) and are editable in
/// /admin/operators without a redeploy. INTL has no bus operators and
/// keeps the standard forwarder math (RegionConfig.shippingBase/PerKg).
model BusOperator {
  id             String  @id @default(cuid())
  /// Region served — RegionConfig.region (UG | KE | TZ | RW | CD)
  regionCode     String
  name           String
  /// Cargo tariff, USD per kg
  cargoRatePerKg Float
  /// Minimum charge per consignment, USD
  minCharge      Float
  transitDaysMin Int
  transitDaysMax Int
  /// Practical booking instructions shown at checkout
  bookingNote    String
  isActive       Boolean @default(true)
  sortOrder      Int     @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  region RegionConfig @relation(fields: [regionCode], references: [region])

  /// Composite key the seed upserts on (operators can repeat across regions
  /// — e.g. Link Bus serves both KE and UG)
  @@unique([regionCode, name])
  @@index([regionCode, isActive])
}

/// Audit of order status transitions (mirrors ERP workflow-transition API)
model OrderEvent {
  id         String   @id @default(cuid())
  orderNumber String
  fromStatus String
  toStatus   String
  note       String?
  createdAt  DateTime @default(now())

  order OrderProcessing @relation(fields: [orderNumber], references: [orderNumber])

  @@index([orderNumber])
}

/// Money actually received for an order.
///
/// Deliberately NOT an OrderEvent: order events render on the customer's public
/// tracking page, so a payment reference written there would be visible to the
/// buyer and to anyone with the order number. This is the owner's private
/// ledger. OrderProcessing.paymentStatus / paidAmountUsd are derived from these
/// rows inside the same transaction that writes them.
model PaymentRecord {
  id         String   @id @default(cuid())
  orderNumber String
  /// MTN MoMo | M-Pesa | Airtel Money | Bank Transfer | Cash on Delivery | Other
  method     String
  /// Transaction / receipt reference quoted by the payer
  reference  String?
  /// Amount received, in USD (the order's base currency)
  amountUsd  Float
  note       String?
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  order OrderProcessing @relation(fields: [orderNumber], references: [orderNumber])

  @@index([orderNumber, receivedAt])
}

/// Restock alerts raised by the storefront — the sold-out tiles' "NOTIFY ME"
/// form posts here, deduplicated per product + email.
model RestockNotify {
  id        String   @id @default(cuid())
  productId String
  email     String
  /// pending | notified | expired — advanced by the ERP when stock returns
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@unique([productId, email])
  @@index([productId])
  @@index([status])
}

/// Newsletter signups from the footer — the store's pre-sale lead list.
/// Deduplicated per email; a repeat signup is a no-op that still resolves
/// success so the footer UI can flip to the confirmed state either way.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// Stock ledger for every stock change OUTSIDE a live sale — receipts,
/// corrections, damages, and cancellations returning units to the shelf.
/// Sales decrement stock through OrderProcessing; this model covers the
/// rest of the truth so warehouse stock and DB stock can be reconciled.
model StockMovement {
  id             String   @id @default(cuid())
  productId      String
  /// signed delta applied to Product.currentStock (+ receipt, − shrinkage)
  delta          Int
  /// stock after applying the delta (snapshot for quick audits)
  resultingStock Int
  /// receipt | adjustment | damage | count_correction | cancellation
  reason         String
  note           String?
  /// CUSTOMER (cancel restock) or ADMIN
  createdBy      String   @default("ADMIN")
  createdAt      DateTime @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
}

/// Fixed-window throttle for storefront account sign-ups. The key is an
/// HMAC of the client IP — the raw IP is never stored (same pattern as
/// AdminLoginAttempt / CustomerLoginAttempt).
model RegisterAttempt {
  id              String   @id
  attempts        Int      @default(0)
  windowStartedAt DateTime @default(now())
}

/// Counter model for generating atomic sequences
model Counter {
  id    String @id @default(cuid())
  name  String @unique
  value Int    @default(0)
}

/// Single-row throttle for the owner credentials endpoint; stores no email or IP.
model AdminLoginAttempt {
  id             String   @id
  attempts       Int      @default(0)
  windowStartedAt DateTime @default(now())
}

model CustomerLoginAttempt {
  id              String   @id
  attempts        Int      @default(0)
  windowStartedAt DateTime @default(now())
}

/// Fixed-window throttle for the public write endpoints (newsletter signup and
/// restock alerts). Stores no email or IP — the id is an HMAC of the caller's
/// address under an endpoint-specific namespace.
model PublicWriteAttempt {
  id              String   @id
  attempts        Int      @default(0)
  windowStartedAt DateTime @default(now())
}
